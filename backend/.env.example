# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas cluster connection string.
# Never commit real credentials to version control.
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<EXISTING_CLUSTER_HOST>/econocausal?retryWrites=true&w=majority
DATABASE_NAME=econocausal

# Authentication & Security
# Generate a secure secret key (e.g., using `openssl rand -hex 32`)
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_ALGORITHM=HS256

# Application Environment
APP_ENV=development
ECONOCAUSAL_DEBUG=false

# Allowed CORS origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-frontend.vercel.app

